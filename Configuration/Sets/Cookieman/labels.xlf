            </trans-unit>
            <trans-unit id="settings.plugin.tx_cookieman.settings.cookie.secure.enum.1">
                <source>On</source>
            </trans-unit>
            <trans-unit id="settings.plugin.tx_cookieman.settings.cookie.secure.enum.0">
                <source>Off</source>
            </trans-unit>
            <trans-unit id="settings.plugin.tx_cookieman.settings.minify.enum.1">
                <source>On</source>
            </trans-unit>
            <trans-unit id="settings.plugin.tx_cookieman.settings.minify.enum.0">
                <source>Off</source>
            </trans-unit>

            </trans-unit>
            <trans-unit id="settings.plugin.tx_cookieman.settings.resourcesBasePath">
                <source>Resources base path</source>
            </trans-unit>
            <trans-unit id="settings.description.plugin.tx_cookieman.settings.resourcesBasePath">
                <source>Path to directory that holds Resources/Private|Public/Themes/&lt;theme&gt;</source>
            </trans-unit>
            <trans-unit id="settings.plugin.tx_cookieman.settings.theme">
                <source>Theme</source>
            </trans-unit>
            <trans-unit id="settings.description.plugin.tx_cookieman.settings.theme">
                <source>Name of theme. Either your custom one or one of the examples: [bootstrap5-modal/bootstrap4-modal/bootstrap3-modal (a simple and straight-forward popup), bootstrap3-banner (a banner that uses some interactive functions)]</source>
            </trans-unit>
            <trans-unit id="settings.plugin.tx_cookieman.settings.links.dataProtectionDeclarationPid">
                <source>Data protection declaration page</source>
            </trans-unit>
            <trans-unit id="settings.description.plugin.tx_cookieman.settings.links.dataProtectionDeclarationPid">
                <source>page ID of data declaration (the cookie banner will not be shown on this page)</source>
            </trans-unit>
            <trans-unit id="settings.plugin.tx_cookieman.settings.links.dataProtectionDeclarationAnchor">
                <source>Data protection declaration anchor</source>
            </trans-unit>
            <trans-unit id="settings.description.plugin.tx_cookieman.settings.links.dataProtectionDeclarationAnchor">
                <source>anchor within data declaration page (if needed)</source>
            </trans-unit>
            <trans-unit id="settings.plugin.tx_cookieman.settings.links.imprintPid">
                <source>Imprint page</source>
            </trans-unit>
            <trans-unit id="settings.description.plugin.tx_cookieman.settings.links.imprintPid">
                <source>page ID of imprint (the cookie banner will not be shown on this page)</source>
            </trans-unit>
            <trans-unit id="settings.plugin.tx_cookieman.settings.links.imprintAnchor">
                <source>Imprint anchor</source>

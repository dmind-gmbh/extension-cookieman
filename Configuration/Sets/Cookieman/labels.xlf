            </trans-unit>
            <trans-unit id="settings.plugin.tx_cookieman.settings.cookie.cookieLifetimeDays">
                <source>Cookie lifetime</source>
            </trans-unit>
            <trans-unit id="settings.description.plugin.tx_cookieman.settings.cookie.cookieLifetimeDays">
                <source>cookie expire time in days (default: 365)</source>
            </trans-unit>
            <trans-unit id="settings.plugin.tx_cookieman.settings.cookie.domain">
                <source>Cookie domain</source>
            </trans-unit>
            <trans-unit id="settings.description.plugin.tx_cookieman.settings.cookie.domain">
                <source>domain without protocol like www.example.com, .example.com (default: the TYPO3 site name)</source>
            </trans-unit>
            <trans-unit id="settings.plugin.tx_cookieman.settings.cookie.sameSite">
                <source>Cookie sameSite</source>
            </trans-unit>
            <trans-unit id="settings.description.plugin.tx_cookieman.settings.cookie.sameSite">
                <source>sameSite attribute. Lax, Strict or None (default: Strict)</source>
            </trans-unit>
            <trans-unit id="settings.plugin.tx_cookieman.settings.cookie.secure">
                <source>Cookie secure</source>
            </trans-unit>
            <trans-unit id="settings.description.plugin.tx_cookieman.settings.cookie.secure">
                <source>send the cookie via https only (default: on). Cookieman sets it only on https pages. Set to 0 only if you have mixed http/https subdomains which must be covered.</source>
            </trans-unit>
            <trans-unit id="settings.plugin.tx_cookieman.settings.consentConfigurationVersion">
                <source>Consent configuration version</source>
            </trans-unit>
            <trans-unit id="settings.description.plugin.tx_cookieman.settings.consentConfigurationVersion">
                <source>version of your cookie configuration (default: 1). Change it to show the consent popup again. The consent of the user does not count until they save again.</source>
            </trans-unit>
            <trans-unit id="settings.plugin.tx_cookieman.settings.minify">
                <source>Minify assets</source>
            </trans-unit>
            <trans-unit id="settings.description.plugin.tx_cookieman.settings.minify">
                <source>include minified CSS/JS (disable for development)</source>
            </trans-unit>
            <trans-unit id="settings.plugin.tx_cookieman.settings.cookie.sameSite.enum.Strict">
                <source>Strict</source>
            </trans-unit>

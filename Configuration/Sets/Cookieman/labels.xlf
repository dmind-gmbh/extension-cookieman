            </trans-unit>
            <trans-unit id="categories.cookieman.links">
                <source>Links</source>
            </trans-unit>
            <trans-unit id="categories.cookieman.cookie">
                <source>Cookie</source>
            </trans-unit>
            <trans-unit id="categories.cookieman.assets">
